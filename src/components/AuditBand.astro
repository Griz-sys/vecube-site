---
import { auditBand as a } from "../data/content";
---

<section class="bg-accent py-14 text-ink md:py-20">
  <div class="wrap grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-14">
    <!-- left: copy -->
    <div>
      <span class="label"><span class="dot"></span> {a.tag}</span>
      <h2 class="h-display mt-4 text-[clamp(2.5rem,7vw,5.5rem)] leading-[0.92]">{a.headline}</h2>
      <p class="mt-6 max-w-[46ch] text-lg leading-snug text-ink/80">
        A focused session with our senior team on what's holding your business back, and what to fix
        first. <span class="font-bold text-ink">No pitch. No commitment.</span>
      </p>
    </div>

    <!-- right: dark steps card -->
    <div class="rounded-[2px] bg-ink p-7 text-white md:p-8">
      <ol class="flex flex-col gap-5">
        {
          a.steps.map((step, i) => (
            <li class="flex gap-4">
              <span class="font-mono text-xs text-accent">{`0${i + 1}`}</span>
              <p class="font-bold leading-snug">{step}</p>
            </li>
          ))
        }
      </ol>
      <a class="btn btn-primary mt-7 w-full justify-center" href="/contact">
        {a.cta} <span class="arw">→</span>
      </a>
    </div>
  </div>
</section>
