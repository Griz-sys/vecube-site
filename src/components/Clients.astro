---
import { clients } from "../data/content";
// row A left-to-right list, row B reversed — each duplicated for a seamless loop
const rowA = [...clients, ...clients];
const reversed = [...clients].reverse();
const rowB = [...reversed, ...reversed];
---

<section id="clients" class="bg-ink py-14 md:py-20 overflow-hidden">
  <div class="wrap mb-8 flex flex-wrap items-center justify-between gap-4">
    <span class="label !text-white/90">
      <span class="dot" style="background:#3ddc84"></span> Clients · {`{ 03 }`}
    </span>
    <h3 class="h-display text-white text-[clamp(1.2rem,2.6vw,2rem)] md:ml-auto md:max-w-[18ch] md:text-right">
      Brands we've built with, across [markets].
    </h3>
  </div>

  <div class="marquee flex flex-col gap-4">
    <!-- row 1 → moves left -->
    <div class="marquee-track gap-4">
      {
        rowA.map((c, i) => (
          <div
            class="group h-24 w-52 flex-none overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] md:h-28 md:w-56"
            aria-hidden={i >= clients.length ? "true" : undefined}
          >
            {c.logo ? (
              <img
                src={c.logo}
                alt={c.name}
                loading="lazy"
                class="h-full w-full object-cover grayscale transition duration-500 group-hover:grayscale-0"
              />
            ) : (
              <span class="flex h-full w-full items-center justify-center px-4 text-center h-display text-lg text-white/85">
                {c.name}
              </span>
            )}
          </div>
        ))
      }
    </div>

    <!-- row 2 → moves right (opposite) -->
    <div class="marquee-track marquee-track--rev marquee-track--slow gap-4">
      {
        rowB.map((c, i) => (
          <div
            class="group h-24 w-52 flex-none overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] md:h-28 md:w-56"
            aria-hidden={i >= clients.length ? "true" : undefined}
          >
            {c.logo ? (
              <img
                src={c.logo}
                alt={c.name}
                loading="lazy"
                class="h-full w-full object-cover grayscale transition duration-500 group-hover:grayscale-0"
              />
            ) : (
              <span class="flex h-full w-full items-center justify-center px-4 text-center h-display text-lg text-white/85">
                {c.name}
              </span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
