---
import { hero } from "../data/content";
---

<!-- Full-bleed hero: image fills the viewport, nav floats on top of it. -->
<section class="-mt-28">
  <h1 class="sr-only">{hero.h1}</h1>

  <div class="relative h-[100svh] min-h-[600px] w-full overflow-hidden">
    <img
      src="/images/banner.webp"
      alt={hero.imageAlt}
      width="2000"
      height="1091"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- small tag, top-left -->
    <div class="wrap absolute inset-x-0 top-32 z-10">
      <span class="label"><span class="dot"></span> {hero.kicker}</span>
    </div>

    <!-- lime sticker, top-right -->
    <span class="sticker absolute right-5 top-44 z-10 md:right-10">{hero.sticker}</span>

    <!-- actions, bottom-right -->
    <div class="wrap absolute inset-x-0 bottom-8 z-10 flex flex-wrap justify-end gap-3">
      <a class="btn btn-primary shadow-lg" href="/contact">
        {hero.ctaPrimary} <span class="arw">→</span>
      </a>
      <a class="btn btn-secondary bg-white shadow-lg" href="/#work">
        {hero.ctaSecondary} <span class="arw">→</span>
      </a>
    </div>
  </div>
</section>
