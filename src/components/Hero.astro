---
import { hero } from "../data/content";
---

<!-- Full-bleed hero: video fills the viewport, nav floats on top of it. -->
<section class="-mt-28">
  <h1 class="sr-only">{hero.h1}</h1>

  <div class="relative h-[100svh] min-h-[600px] w-full overflow-hidden">
    <!-- pre-rendered forward+reverse boomerang, looped natively (smooth, no seeking) -->
    <video
      id="hero-video"
      class="absolute inset-0 h-full w-full object-cover"
      src="/videos/hero-boomerang.mp4"
      poster="/images/banner.webp"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label={hero.imageAlt}
    ></video>

    <!-- soft blurred patch over the bottom-right area only (hides the watermark) -->
    <div
      class="pointer-events-none absolute bottom-0 right-0 z-[5] h-44 w-[55%] backdrop-blur-lg"
      style="-webkit-mask-image:radial-gradient(110% 130% at 100% 100%, #000 60%, transparent 90%); mask-image:radial-gradient(110% 130% at 100% 100%, #000 60%, transparent 90%);"
    >
    </div>

    <!-- small tag, top-left -->
    <div class="wrap absolute inset-x-0 top-32 z-10">
      <span class="label"><span class="dot"></span> {hero.kicker}</span>
    </div>

    <!-- lime sticker, top-right -->
    <span class="sticker absolute right-5 top-44 z-10 md:right-10">{hero.sticker}</span>

    <!-- actions, bottom-right — one pill split into two halves (also covers the video watermark) -->
    <div class="wrap absolute inset-x-0 bottom-8 z-10 flex justify-end">
      <div class="inline-flex overflow-hidden rounded-full font-body text-base font-semibold shadow-[0_14px_40px_rgba(0,0,0,0.22)]">
        <a
          class="group flex items-center gap-2 bg-blue px-8 py-4 text-white transition-colors hover:bg-blue-dk"
          href="/contact"
        >
          {hero.ctaPrimary}
          <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
        <a
          class="group flex items-center gap-2 bg-white px-8 py-4 text-ink transition-colors hover:bg-grey-05"
          href="/#work"
        >
          {hero.ctaSecondary}
          <span class="text-blue transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
