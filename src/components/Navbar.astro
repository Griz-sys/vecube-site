---
import { nav } from "../data/content";
import MobileNav from "./MobileNav.tsx";
---

<!-- floating pill nav that sits on top of the page/hero -->
<header class="fixed inset-x-0 top-0 z-50">
  <div class="wrap pt-4">
    <div
      class="flex items-center justify-between gap-4 rounded-full border border-grey-10 bg-paper/90 px-5 py-2.5 shadow-[0_12px_34px_rgba(0,0,0,0.10)] backdrop-blur-md"
    >
      <a href="/" class="h-display text-[1.5rem] leading-none">
        VE<span class="text-blue">CUBE</span>
      </a>

      <nav class="hidden items-center gap-8 md:flex">
        {
          nav.map((item) => (
            <a href={item.href} class="group relative text-[0.95rem] font-medium">
              {item.label}
              <span class="absolute -bottom-1.5 left-0 h-0.5 w-0 bg-blue transition-[width] duration-200 group-hover:w-full" />
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <a class="btn btn-primary hidden sm:inline-flex" href="/contact">
          Get in touch <span class="arw">→</span>
        </a>
        <MobileNav client:load nav={nav} email="hello@vecube.club" />
      </div>
    </div>
  </div>
</header>
