---
import { nav } from "../data/content";
import MobileNav from "./MobileNav.tsx";
---

<!-- floating pill nav that morphs into a full-width top bar on scroll -->
<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <div id="nav-inner" class="wrap pt-4">
    <div
      id="nav-pill"
      class="flex items-center justify-between gap-4 rounded-2xl bg-ink px-6 py-3.5 md:px-8 md:py-4"
    >
      <a href="/" class="flex items-center" aria-label="hiccup home">
        <img src="/images/hiccup.svg" alt="hiccup" class="h-7 w-auto md:h-8" />
      </a>

      <nav class="hidden items-center gap-9 md:flex">
        {
          nav.map((item) => (
            <a href={item.href} class="group relative text-[1.05rem] font-medium lowercase text-cream">
              {item.label}
              <span class="absolute -bottom-1.5 left-0 h-0.5 w-0 bg-neon transition-[width] duration-200 group-hover:w-full" />
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <a class="btn btn-primary hidden sm:inline-flex" href="/contact">
          Get in touch <span class="arw">→</span>
        </a>
        <MobileNav client:load nav={nav} email="hello@vecube.club" />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const h = document.getElementById("site-header");
    const inner = document.getElementById("nav-inner");
    if (!h) return;
    // publish the real header height so sticky sub-navs sit flush below it
    const setH = () => document.documentElement.style.setProperty("--header-h", h.offsetHeight + "px");
    // past the hero, morph the floating pill into a full-width top bar
    const onScroll = () => {
      h.classList.toggle("is-scrolled", window.scrollY > 24);
      setH();
    };
    setH();
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", setH, { passive: true });
    // the morph changes the bar's height — re-measure once it settles
    inner && inner.addEventListener("transitionend", setH);
  })();
</script>
