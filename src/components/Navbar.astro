---
import { nav, site } from "../data/content";
import MobileNav from "./MobileNav.tsx";
---

<header class="sticky top-0 z-50 bg-paper/85 backdrop-blur-md border-b border-grey-10">
  <div class="wrap flex items-center justify-between h-[72px]">
    <a href="/" class="h-display text-[1.6rem] leading-none">
      VE<span class="text-blue">CUBE</span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="group relative text-[0.95rem] font-medium"
          >
            {item.label}
            <span class="absolute left-0 -bottom-1.5 h-0.5 w-0 bg-blue transition-[width] duration-200 group-hover:w-full" />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a class="btn btn-primary hidden sm:inline-flex" href="/contact">
        Get in touch <span class="arw">→</span>
      </a>
      <MobileNav client:load nav={nav} email={site.email} />
    </div>
  </div>
</header>
