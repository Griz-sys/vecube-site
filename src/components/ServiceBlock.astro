---
import type { ServiceSection } from "../data/content";
interface Props { s: ServiceSection }
const { s } = Astro.props;
---

<section id={s.anchor} class="scroll-mt-[9rem] border-t border-grey-10 py-14 md:py-20">
  <div class="wrap grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
    <!-- LEFT: headline, when, cta, proof, works-with -->
    <div class="md:col-span-5">
      <span class="label"><span class="dot"></span> {s.num} · {s.label}</span>
      <h2 class="h-display mt-4 text-[clamp(2rem,4.5vw,3.6rem)]">{s.headline}</h2>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a class="btn btn-primary" href={s.cta.href}>{s.cta.label} <span class="arw">→</span></a>
        {s.cta.reply && (
          <span class="font-mono text-xs uppercase tracking-[0.08em] text-grey-40">· {s.cta.reply}</span>
        )}
      </div>

      <p class="label mt-9">When clients usually call us</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {s.when.map((w) => (
          <li class="rounded-full bg-grey-05 px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.04em] text-grey-60">
            {w}
          </li>
        ))}
      </ul>

      <!-- proof card -->
      <div class="grain relative mt-8 overflow-hidden rounded-[2px] bg-ink p-6 text-white">
        <span class="font-mono text-xs uppercase tracking-[0.12em] text-accent">{s.proof.label}</span>
        <p class="mt-3 text-lg leading-snug">{s.proof.line}</p>
        <p class="mt-3 font-bold text-accent">{s.proof.result}</p>
        <a class="btn btn-tertiary mt-4 !px-0 !text-white" href="/#work">
          <span class="txt">See the case</span> <span class="arw">→</span>
        </a>
      </div>

      <!-- works best with -->
      <div class="mt-7">
        <p class="label">Works best with</p>
        <div class="mt-2 flex flex-wrap gap-4">
          {s.worksWith.links.map((l) => (
            <a class="btn btn-tertiary !px-0" href={l.href}>
              <span class="txt">{l.label}</span> <span class="arw">→</span>
            </a>
          ))}
        </div>
        <p class="mt-2 max-w-[40ch] text-sm text-grey-60">{s.worksWith.line}</p>
      </div>
    </div>

    <!-- RIGHT: what we do -->
    <div class="md:col-span-6 md:col-start-7">
      {
        s.groups.map((g) => (
          <div class="mb-8 last:mb-0">
            {g.title && (
              <p class="label mb-2"><span class="dot"></span> {g.title}</p>
            )}
            <ul class="border-t border-grey-10">
              {g.items.map((it) => (
                <li class="border-b border-grey-10 py-4">
                  <span class="h-display text-lg">{it.name}</span>
                  <p class="mt-1 text-grey-60">{it.desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
