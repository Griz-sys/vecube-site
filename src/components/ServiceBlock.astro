---
import type { ServiceSection } from "../data/content";
interface Props { s: ServiceSection; alt?: boolean }
const { s, alt = false } = Astro.props;
const bg = alt ? "bg-grey-05" : "bg-cream";

// three themed photos per service (/public/images/services/<anchor>-1..3.jpg)
const tiles = [1, 2, 3].map((k) => `/images/services/${s.anchor}-${k}.jpg`);
---

<section id={s.anchor} class={`svc-section scroll-mt-[10rem] border-t border-grey-10 ${bg}`}>
  <div class="wrap py-12 md:py-16">
    <div class="grid grid-cols-1 gap-y-8 lg:grid-cols-[1fr_1.9fr] lg:gap-x-12">
      <!-- LEFT: name + hoverable sub-list -->
      <div>
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-grey-40">
          {s.num} · {s.label}
        </span>
        <h2 class="h-display mt-2 text-[clamp(2rem,4vw,3rem)] leading-[0.9]">{s.name}.</h2>
        <div class="svc-list mt-6 space-y-5">
          {
            s.groups.map((g) => (
              <div>
                {g.title && (
                  <p class="mb-2 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-grey-40">{g.title}</p>
                )}
                <ul class="space-y-1.5">
                  {g.items.map((it) => (
                    <li
                      class="svc-cap group flex cursor-pointer items-center gap-2 leading-snug text-grey-60 transition-colors hover:text-ink"
                      tabindex="0"
                      data-name={it.name}
                      data-desc={it.desc}
                    >
                      <span class="svc-dot h-1.5 w-1.5 flex-none rounded-full bg-blue opacity-0 transition-opacity duration-200 group-hover:opacity-100" />
                      <span>{it.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <!-- RIGHT: description (swaps on hover) + image strip -->
      <div>
        <div class="svc-detail min-h-[6rem]">
          <div class="svc-detail-text max-w-[44ch] text-xl leading-snug md:text-2xl">
            {s.headlinePre} <span class="text-blue">{s.headlineAccent}</span>
          </div>
        </div>
        <div class="mt-7 grid grid-cols-3 gap-3 md:gap-4">
          {
            tiles.map((src) => (
              <a
                href="/work"
                class="group relative aspect-[4/5] overflow-hidden rounded-[16px] bg-grey-05 transition-transform duration-300 hover:-translate-y-1"
              >
                <img
                  src={src}
                  alt={`${s.name} work`}
                  loading="lazy"
                  onerror="this.style.display='none'"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hover a capability → the right-side description shows that capability's blurb.
  // Bundled once by Astro even though <ServiceBlock> renders multiple times.
  document.querySelectorAll<HTMLElement>(".svc-section").forEach((sec) => {
    const detail = sec.querySelector<HTMLElement>(".svc-detail-text");
    const list = sec.querySelector<HTMLElement>(".svc-list");
    if (!detail || !list) return;
    const fallback = detail.innerHTML;
    const caps = Array.from(sec.querySelectorAll<HTMLElement>(".svc-cap"));

    const show = (cap: HTMLElement) => {
      const name = cap.dataset.name ?? "";
      const desc = cap.dataset.desc ?? "";
      detail.innerHTML =
        `<span class="block h-display text-2xl md:text-3xl">${name}</span>` +
        `<span class="mt-2 block text-base leading-snug text-grey-60 md:text-lg">${desc}</span>`;
      caps.forEach((c) => c.classList.remove("is-active"));
      cap.classList.add("is-active");
    };
    const reset = () => {
      detail.innerHTML = fallback;
      caps.forEach((c) => c.classList.remove("is-active"));
    };

    caps.forEach((cap) => {
      cap.addEventListener("mouseenter", () => show(cap));
      cap.addEventListener("focus", () => show(cap));
      cap.addEventListener("click", () => show(cap));
    });
    list.addEventListener("mouseleave", reset);
  });
</script>
