---
import { midCta as c } from "../data/content";
---

<!-- Mid-page CTA — sits right after the proof, where intent peaks -->
<section class="py-12 md:py-16">
  <div class="wrap">
    <div class="relative overflow-hidden rounded-[2px] bg-blue px-6 py-8 text-white md:px-10 md:py-10">
      <span class="sticker absolute right-5 top-5">{`{ 09 }`}</span>

      <div class="flex flex-wrap items-center justify-between gap-6">
        <div>
          <h2 class="h-display max-w-[18ch] text-[clamp(1.8rem,4vw,3.2rem)]">{c.headline}</h2>
          <p class="mt-3 max-w-[46ch] text-base leading-snug text-white/85">{c.line}</p>
        </div>
        <a
          class="btn flex-none bg-white !text-blue hover:bg-accent hover:!text-ink"
          style="padding:1.05rem 2rem;height:3.75rem;font-size:1.05rem;"
          href="/contact"
        >
          {c.cta} <span class="arw">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
