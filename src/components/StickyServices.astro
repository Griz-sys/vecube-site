---
import { services } from "../data/content";
---

<!--
  Services as a sticky stack: each card pins just below the nav at a slightly
  larger offset, so they pile up as you scroll. Pure CSS (.svc-sticky), no JS.
-->
<div class="flex flex-col gap-8">
  {
    services.map((s, i) => (
      <article
        class="svc-sticky overflow-hidden rounded-[2px] border-2 border-ink bg-paper shadow-[0_18px_50px_rgba(0,0,0,0.10)]"
        style={`top: calc(7rem + ${i} * 1.75rem); z-index: ${i + 1};`}
      >
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="flex min-h-[300px] flex-col justify-between p-7 md:p-10">
            <div>
              <span class="font-mono text-xs uppercase tracking-[0.12em] text-grey-40">
                {s.num} · Service
              </span>
              <h3 class="h-display mt-2 text-[clamp(2.2rem,4.5vw,3.6rem)]">{s.name}</h3>
              <p class="mt-3 max-w-[42ch] text-grey-60">{s.blurb}</p>
            </div>
            <div>
              <ul class="mb-4 flex flex-wrap gap-2">
                {(s.tags ?? s.items).slice(0, 4).map((t) => (
                  <li class="rounded-full bg-grey-05 px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.04em] text-grey-60">
                    {t}
                  </li>
                ))}
              </ul>
              <a href={s.href ?? "/services"} class="btn btn-tertiary !px-0">
                <span class="txt">Explore {s.name}</span> <span class="arw">→</span>
              </a>
            </div>
          </div>

          <div class="relative hidden bg-grey-05 md:block">
            {s.image && (
              <img src={s.image} alt={s.name} class="absolute inset-0 h-full w-full object-cover" />
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
