---
import { services } from "../data/content";
// small colour moment per pillar (Bark-style colour-coded columns)
const accents = ["#1f43ff", "#7c3aed", "#0ea5a3", "#f59e0b"];
---

<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
  {
    services.map((s, i) => (
      <div>
        <div class="h-[3px] w-full" style={`background:${accents[i % accents.length]}`} />
        <div class="mt-4 flex items-baseline gap-3">
          <span class="font-mono text-xs text-grey-40">{s.num}</span>
          <h3 class="h-display text-[clamp(1.6rem,2.4vw,2.4rem)]">{s.name}</h3>
        </div>
        <p class="mt-3 max-w-[34ch] text-sm leading-snug text-grey-60">{s.blurb}</p>
        <ul class="mt-5 border-t border-grey-10">
          {s.items.map((item) => (
            <li class="flex items-start gap-2 border-b border-grey-10 py-2.5 text-[0.95rem] leading-tight">
              <span class="mt-0.5 text-blue">↳</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
