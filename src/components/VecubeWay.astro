---
import { vecubeWay as w, waySteps } from "../data/content";

const cardClass = (i: number) =>
  i === 0
    ? "bg-ink text-white"
    : i === waySteps.length - 1
      ? "bg-blue text-white"
      : "bg-grey-05 text-ink";
const muted = (i: number) => (i === 0 || i === waySteps.length - 1 ? "text-white/70" : "text-grey-60");
const arrowClass = (i: number) => (i === 0 || i === waySteps.length - 1 ? "text-white/60" : "text-blue");
---

<section id="how-we-work" class="scroll-mt-28 py-12 md:py-16">
  <div class="wrap">
    <!-- header: headline (left) + Rx slip (right) -->
    <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <span class="label"><span class="dot"></span> {w.tag} · {`{ 06 }`}</span>
        <h2 class="h-display mt-4 max-w-[14ch] text-[clamp(2.5rem,6.5vw,6rem)]">
          {w.headlinePre}{" "}
          <span
            class="text-blue"
            style="background:linear-gradient(transparent 58%, var(--color-accent) 58%);padding:0 0.05em;"
            >{w.headlineAccent}</span
          >
        </h2>
        <p class="mt-6 max-w-[46ch] text-lg leading-snug text-grey-60">{w.sub}</p>
      </div>

      <!-- Rx prescription slip -->
      <div class="md:col-span-5">
        <div
          class="grain relative rotate-[-1.5deg] overflow-hidden rounded-[2px] border-2 border-ink bg-paper p-6 shadow-[0_16px_40px_rgba(0,0,0,0.12)] md:p-7"
        >
          <div class="flex items-baseline gap-3 border-b border-grey-10 pb-3">
            <span class="font-display text-2xl font-black italic">Rx</span>
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-grey-60">
              {w.rxHeader}
            </span>
          </div>
          <ul class="mt-4 flex flex-col gap-2">
            {
              w.rxItems.map((item) => (
                <li class="flex items-center gap-2 text-base text-grey-40 line-through decoration-blue decoration-2">
                  <span aria-hidden="true" class="text-blue no-underline">✗</span>
                  {item}
                </li>
              ))
            }
          </ul>
          <div class="mt-5 flex items-center justify-between border-t border-grey-10 pt-3">
            <span class="h-display">{w.rxFooter}</span>
            <span class="flex items-center gap-1.5 font-mono text-sm font-bold text-blue">
              {w.rxBrand} <span aria-hidden="true">✓</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- rising staircase -->
    <div class="mt-14 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:items-start">
      {
        waySteps.map((s, i) => (
          <div
            class={`way-step relative flex min-h-[220px] flex-col justify-between rounded-[2px] p-5 ${cardClass(i)}`}
            style={`--i:${waySteps.length - 1 - i}`}
          >
            {i === 0 && <span class="sticker absolute -top-3 left-4 z-10">{w.startHere}</span>}
            <div class="flex items-start justify-between">
              <span class="h-display text-[2.5rem] leading-none">{s.num}</span>
              <span class={`text-xl ${arrowClass(i)}`} aria-hidden="true">↗</span>
            </div>
            <div>
              <h3 class="h-display text-xl">{s.step}</h3>
              <p class={`mt-1 text-sm leading-snug ${muted(i)}`}>{s.line}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- dashed baseline + loop pill -->
    <div class="mt-5 flex items-center gap-4">
      <div class="flex-1 border-t border-dashed border-grey-20"></div>
      <div
        class="inline-flex flex-none items-center gap-2 rounded-full bg-ink px-5 py-2.5 font-mono text-sm uppercase tracking-[0.08em] text-white"
      >
        <span aria-hidden="true">↺</span> {w.loop}
      </div>
    </div>
  </div>
</section>
