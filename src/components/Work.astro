---
import { work } from "../data/content";
---

<section id="work" class="py-12 md:py-16">
  <div class="wrap">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-5">
      <div>
        <span class="label"><span class="dot"></span> Selected work · {`{ 05 }`}</span>
        <h2 class="h-display mt-4 text-[clamp(2.75rem,7vw,7rem)]">Our work.</h2>
      </div>
      <a class="btn btn-secondary" href="/#work">View all case studies <span class="arw">→</span></a>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        work.map((c) => (
          <article class="group cursor-pointer">
            <div
              class="grain relative flex aspect-square items-end overflow-hidden rounded-[2px] p-6"
              style="background:linear-gradient(150deg,#20242e,#0b0d14)"
            >
              {c.image && (
                <img
                  src={c.image}
                  alt=""
                  class="absolute inset-0 z-[1] h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
              )}
              <div
                class="absolute inset-0 z-0"
                style="background:radial-gradient(120% 90% at 20% 10%,rgba(31,67,255,0.5),transparent 60%)"
              />
              <div class="relative z-[2] text-white">
                <span class="h-display block text-[clamp(2.5rem,5vw,4.5rem)] leading-none">
                  {c.stat}
                </span>
                <span class="font-mono text-xs uppercase tracking-[0.1em] text-accent">
                  {c.statLabel}
                </span>
              </div>
            </div>

            <div class="mt-4">
              <div class="mb-3 flex flex-wrap gap-2">
                {c.tags.map((t) => (
                  <span class="rounded-full bg-grey-05 px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.06em] text-grey-60 transition-colors duration-200 group-hover:bg-blue group-hover:text-white">
                    {t}
                  </span>
                ))}
              </div>
              <h4 class="h-display text-2xl">
                <span
                  class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_2px] bg-[position:0_100%] bg-no-repeat transition-[background-size] duration-200 group-hover:bg-[length:100%_2px]"
                >
                  {c.name}
                </span>
              </h4>
              <p class="mt-1 text-grey-60">{c.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
