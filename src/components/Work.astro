---
import { work, workMeta as m } from "../data/content";
---

<section id="work" class="scroll-mt-28 py-12 md:py-16">
  <div class="wrap">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <div>
        <span class="label"><span class="dot"></span> {m.tag} · {`{ 08 }`}</span>
        <h2 class="h-display mt-4 text-[clamp(2.75rem,7vw,7rem)]">{m.headline}</h2>
      </div>
      <div class="flex flex-col items-start gap-4 md:items-end">
        <p class="max-w-[24ch] text-lg leading-snug text-grey-60 md:text-right">{m.line}</p>
        <a class="btn btn-secondary" href="/#work">{m.cta} <span class="arw">→</span></a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        work.map((c) => (
          <article class="group cursor-pointer">
            <div
              class="relative flex aspect-square items-center justify-center overflow-hidden rounded-[2px]"
              style={`background:${c.color ?? "#0b0d14"}`}
            >
              {/* fallback shown until the logo file is added (or if it fails to load) */}
              <span class={`h-display px-6 text-center text-[clamp(1.4rem,3vw,2.2rem)] ${c.light ? "text-ink" : "text-white"}`}>
                {c.name}
              </span>
              {c.image && (
                <img
                  src={c.image}
                  alt={c.name}
                  loading="lazy"
                  onerror="this.remove()"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
              )}
            </div>

            <div class="mt-4">
              <div class="mb-3 flex flex-wrap gap-2">
                {c.tags.map((t) => (
                  <span class="rounded-full bg-grey-05 px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.04em] text-grey-60 transition-colors duration-200 group-hover:bg-blue group-hover:text-white">
                    {t}
                  </span>
                ))}
              </div>
              <h4 class="h-display text-2xl">
                <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_2px] bg-[position:0_100%] bg-no-repeat transition-[background-size] duration-200 group-hover:bg-[length:100%_2px]">
                  {c.name}
                </span>
              </h4>
              <p class="mt-1 text-grey-60">{c.desc}</p>
              {c.result && (
                <p class="mt-2 font-bold text-blue">{c.result}</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
