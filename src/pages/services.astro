---
import Layout from "../layouts/Layout.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import AuditBand from "../components/AuditBand.astro";
import {
  servicesHero as hero,
  serviceSections,
  together,
  faq,
  servicesClosing as closing,
} from "../data/content";
---

<Layout
  title="Services — Vecube | Brand, Media, Dev & Strategy"
  description="Brand, media, tech and strategy under one team. Start with one service or bring in all four — one team owns the plan, the work and the results."
>
  <!-- HERO -->
  <section class="py-10 md:py-14">
    <div class="wrap">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <span class="label"><span class="dot"></span> {hero.tag}</span>
        <span class="sticker">{hero.sticker}</span>
      </div>
      <h1 class="h-display mt-6 max-w-[16ch] text-[clamp(2.75rem,9vw,7.5rem)]">
        {hero.headlineMain} <span class="text-blue">{hero.headlineAccent}</span>
      </h1>
      <p class="mt-6 max-w-[56ch] text-lg leading-snug text-grey-60">
        {hero.linePre} <span class="font-bold text-ink">{hero.lineBold}</span>
      </p>
      <a
        class="btn mt-8 bg-ink text-white hover:bg-grey-60"
        style="padding:1.05rem 2rem;height:3.75rem;font-size:1.05rem;"
        href="/contact"
      >
        {hero.cta} <span class="arw">→</span>
      </a>
    </div>
  </section>

  <!-- SOLUTION BAR (sticky, dark) -->
  <nav id="solution-bar" class="sticky top-[6.25rem] z-40 bg-ink text-white">
    <div class="wrap grid grid-cols-2 md:grid-cols-4">
      {
        serviceSections.map((s, i) => (
          <a
            href={`#${s.anchor}`}
            data-spy={s.anchor}
            class={`spy-link group flex flex-col gap-1 border-white/15 px-5 py-4 ${i > 0 ? "border-l" : ""}`}
          >
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-white/50">
              {s.num} · {s.label}
            </span>
            <span class="h-display text-lg md:text-xl">{s.name}</span>
          </a>
        ))
      }
    </div>
  </nav>

  <!-- SERVICE BLOCKS (audit band after Media) -->
  {serviceSections.slice(0, 2).map((s) => <ServiceBlock s={s} />)}
  <AuditBand />
  {serviceSections.slice(2).map((s) => <ServiceBlock s={s} />)}

  <!-- HOW THE FOUR WORK TOGETHER -->
  <section class="border-t border-grey-10 bg-grey-05 py-14 md:py-20">
    <div class="wrap">
      <span class="label"><span class="dot"></span> {together.tag}</span>
      <h2 class="h-display mt-4 text-[clamp(2.25rem,6vw,5rem)]">{together.headline}</h2>
      <p class="mt-5 max-w-[48ch] text-lg text-grey-60">{together.line}</p>

      <ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          together.steps.map((step, i) => {
            const themes = [
              "bg-blue text-white",
              "bg-accent text-ink",
              "bg-grey-10 text-ink",
              "bg-ink text-white",
            ];
            return (
              <li class={`flex min-h-[190px] flex-col justify-between rounded-[2px] p-6 ${themes[i % 4]}`}>
                <span class="font-mono text-xs uppercase tracking-[0.1em] opacity-70">
                  Step {i + 1} · {step.label}
                </span>
                <p class="mt-6 text-lg font-bold leading-snug">{step.text}</p>
              </li>
            );
          })
        }
      </ol>
      <p class="h-display mt-10 text-[clamp(1.4rem,3vw,2.4rem)]">
        One team. One plan. <span class="text-blue">One point of contact.</span>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-grey-10 py-14 md:py-20">
    <div class="wrap grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <span class="label"><span class="dot"></span> {faq.tag}</span>
        <h2 class="h-display mt-4 text-[clamp(2.25rem,6vw,4.5rem)]">{faq.headline}</h2>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        <div class="border-t border-grey-10">
          {
            faq.items.map((item) => (
              <details class="group border-b border-grey-10 py-5">
                <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
                  <span class="h-display text-lg md:text-xl">{item.q}</span>
                  <span class="text-blue transition-transform duration-200 group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 max-w-[52ch] text-grey-60">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="grain relative overflow-hidden bg-ink py-16 text-white md:py-24">
    <div class="wrap relative z-10 text-center">
      <span class="sticker">{closing.sticker}</span>
      <h2 class="h-display mx-auto mt-6 max-w-[18ch] text-[clamp(2.5rem,8vw,6.5rem)]">{closing.headline}</h2>
      <p class="mx-auto mt-5 max-w-[46ch] text-lg text-white/80">{closing.line}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a
          class="btn btn-primary"
          style="padding:1.05rem 2rem;height:3.75rem;font-size:1.05rem;"
          href={closing.buttons[0].href}
        >
          {closing.buttons[0].label} <span class="arw">→</span>
        </a>
        <a
          class="btn border-2 border-white/40 text-white hover:border-white"
          style="padding:0.9rem 1.85rem;height:3.75rem;font-size:1.05rem;"
          href={closing.buttons[1].href}
        >
          {closing.buttons[1].label} <span class="arw">→</span>
        </a>
      </div>
      <p class="mt-12 font-mono text-sm uppercase tracking-[0.12em] text-white/50">{closing.signoff}</p>
    </div>
  </section>

  <script>
    // scroll-spy: highlight the current section in the sticky solution bar
    const links = Array.from(document.querySelectorAll<HTMLElement>(".spy-link"));
    const byAnchor = new Map(links.map((l) => [l.dataset.spy, l]));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove("spy-active"));
            byAnchor.get(e.target.id)?.classList.add("spy-active");
          }
        });
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
    );
    ["brand", "media", "dev", "venture"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  </script>
</Layout>
