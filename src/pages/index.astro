---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ServiceVideo from "../components/ServiceVideo.astro";
import FounderCta from "../components/FounderCta.astro";
import Clients from "../components/Clients.astro";
import Services from "../components/Services.astro";
import Problems from "../components/Problems.astro";
import Work from "../components/Work.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
---

<Layout
  title="Vecube | Strategy, Brand, Media & Tech Agency"
  description="One team across strategy, brand, media and technology. We find what's holding your business back, then build the fix."
>
  <!-- 01 --><Hero />
  <!-- 02 --><ServiceVideo />
  <!-- founder note --><FounderCta />
  <!-- 03 --><Clients />

  <!-- 04 · Service -->
  <section id="services" class="py-12 md:py-16">
    <div class="wrap">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="label"><span class="dot"></span> What we do · {`{ 04 }`}</span>
          <h2 class="h-display mt-4 text-[clamp(2.75rem,7vw,7rem)]">Services.</h2>
        </div>
        <p class="max-w-[26ch] text-lg leading-snug text-grey-60 md:text-right">
          Four ways in. One team behind all of them.
        </p>
      </div>
      <Services />
    </div>
  </section>

  <!-- 05 --><Problems />
  <!-- 06 --><Work />
  <!-- 07 --><LeadMagnet />
  <!-- bottom tile (contact CTA + footer) lives in the shared Footer -->
</Layout>
