---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ServiceVideo from "../components/ServiceVideo.astro";
import FounderCta from "../components/FounderCta.astro";
import Clients from "../components/Clients.astro";
import { services } from "../data/content";
import Problems from "../components/Problems.astro";
import VecubeWay from "../components/VecubeWay.astro";
import GoodFit from "../components/GoodFit.astro";
import Work from "../components/Work.astro";
import MidCta from "../components/MidCta.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
---

<Layout
  title="Vecube | Strategy, Brand, Media & Tech Agency"
  description="One team across strategy, brand, media and technology. We find what's holding your business back, then build the fix."
>
  <!-- 01 --><Hero />
  <!-- 02 --><ServiceVideo />
  <!-- founder note --><FounderCta />
  <!-- clients (above services) --><Clients />

  <!-- 04 · Service -->
  <section id="services" class="py-16 md:py-24">
    <div class="wrap">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <h2 class="h-display text-[clamp(2.75rem,7vw,6rem)]">Services.</h2>
        <p class="max-w-[26ch] text-lg leading-snug text-grey-60 md:text-right">
          Four ways in. One team behind all of them.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {
          services.map((s) => (
            <a
              href={s.href ?? "/services"}
              class="group relative block aspect-[4/3] overflow-hidden rounded-[24px]"
            >
              {s.image && (
                <img
                  src={s.image}
                  alt={s.name}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              )}
              <div
                class="absolute inset-0"
                style="background:linear-gradient(180deg, rgba(10,10,10,0.1) 0%, rgba(10,10,10,0.5) 50%, rgba(10,10,10,0.9) 100%)"
              />
              <div class="absolute inset-0 z-10 flex flex-col justify-end p-5 text-white">
                <span class="font-mono text-[0.66rem] uppercase tracking-[0.12em] text-neon">
                  {s.num} · service
                </span>
                <h3 class="h-display mt-1 text-[clamp(1.6rem,2.4vw,2.2rem)]">{s.name}</h3>
                <p class="mt-2 text-sm leading-snug text-white/80">{s.blurb}</p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {(s.tags ?? s.items).slice(0, 3).map((t) => (
                    <li class="rounded-full border border-white/25 px-2 py-0.5 font-mono text-[0.55rem] uppercase tracking-[0.04em] text-white/85">
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 05 --><Problems />
  <!-- 06 --><VecubeWay />
  <!-- 07 --><GoodFit />
  <!-- 08 --><Work />
  <!-- 09 --><MidCta />
  <!-- 10 --><LeadMagnet />
  <!-- bottom tile (contact CTA + footer) lives in the shared Footer -->
</Layout>
