---
import Layout from "../../layouts/Layout.astro";
import { workPage as wp, workCases, workUnderway } from "../../data/content";

const cats = (d: string[]) => d.map((x) => x.toLowerCase()).join(",");
---

<Layout
  title="Work — Vecube | Brand, media, dev & venture case studies"
  description="Work that ships, not slides that sit. Strategy, brand, media and tech, owned end to end by one team."
>
  <!-- HERO -->
  <section class="py-10 md:py-14">
    <div class="wrap">
      <span class="label">{wp.tag}</span>
      <h1 class="h-display mt-5 max-w-[18ch] text-[clamp(2.5rem,8vw,6.5rem)]">
        {wp.headline}
      </h1>
      <p class="mt-6 max-w-[52ch] text-lg leading-snug text-grey-60">
        {wp.line}
      </p>

      <!-- FILTER PILLS -->
      <div class="mt-9 flex flex-wrap gap-3">
        {
          wp.filters.map((f, i) => (
            <button
              type="button"
              class:list={["chip", { "is-active": i === 0 }]}
              data-filter={f.toLowerCase()}
            >
              {f}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CASE GRID -->
  <section class="pb-16 md:pb-24">
    <div class="wrap">
      <div id="work-grid" class="grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2">
        {
          workCases.map((c) => (
            <a href={`/work/${c.slug}`} class="work-card group block" data-cats={cats(c.disciplines)}>
              <div
                class:list={["work-tile", { "work-tile--contain": c.imageFit === "contain" }]}
                style={`background:${
                  c.imageFit === "contain"
                    ? c.color ?? "var(--color-ink)"
                    : c.color
                      ? c.color + "14"
                      : "var(--color-grey-05)"
                }`}
              >
                {c.image ? (
                  <img src={c.image} alt={c.asset} loading="lazy" />
                ) : (
                  <span class="px-6 text-center font-mono text-xs uppercase tracking-[0.12em] text-grey-40">
                    [ asset: {c.asset} ]
                  </span>
                )}
              </div>

              <div class="mt-5 flex flex-wrap items-center gap-2">
                {c.disciplines.map((d) => (
                  <span class="rounded-full bg-grey-05 px-3 py-1 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-grey-60">
                    {d}
                  </span>
                ))}
                {c.market && (
                  <span class="font-mono text-[0.62rem] uppercase tracking-[0.1em] text-grey-40">
                    {c.market}
                  </span>
                )}
              </div>

              <p class="mt-3 font-mono text-xs uppercase tracking-[0.12em] text-grey-40">{c.client}</p>
              <h2 class="h-display mt-1 max-w-[20ch] text-2xl md:text-[1.7rem]">{c.title}</h2>
              <span class="btn-tertiary mt-3 inline-flex items-center text-[0.95rem] font-semibold lowercase">
                <span class="txt">view case</span> <span class="arw ml-1">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ALSO UNDERWAY -->
  <section class="border-t border-grey-10 py-16 md:py-20">
    <div class="wrap">
      <span class="label">{wp.underwayTag}</span>
      <p class="mt-3 max-w-[48ch] text-lg text-grey-60">{wp.underwayLine}</p>
      <div class="mt-9 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          workUnderway.map((u) => (
            <div class="rounded-[20px] border border-grey-10 bg-grey-05 p-7">
              <h3 class="h-display text-3xl">{u.client}</h3>
              <p class="mt-2 text-grey-60">{u.line}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {u.disciplines.map((d) => (
                  <span class="rounded-full border border-grey-10 px-3 py-1 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-grey-60">
                    {d}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CREDENTIALS (dark) -->
  <section class="bg-ink py-20 text-cream md:py-24">
    <div class="wrap grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="label" style="color:rgba(251,243,234,0.55)">{wp.credentials.tag}</span>
        <h2 class="h-display mt-5 max-w-[14ch] text-[clamp(2.25rem,5vw,4rem)]">
          {wp.credentials.headline}
          <span class="text-lavender">{wp.credentials.headlineAccent}</span>
        </h2>
      </div>

      <form
        class="flex flex-col gap-4 rounded-[24px] bg-white/[0.04] p-7 ring-1 ring-white/10"
        onsubmit="return false"
      >
        {
          wp.credentials.fields.map((f) => (
            <label class="flex flex-col gap-1.5">
              <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-cream/50">{f.label}</span>
              <input
                type={f.type}
                name={f.name}
                placeholder={f.label}
                class="rounded-xl border border-white/15 bg-transparent px-4 py-3 text-cream placeholder:text-cream/30 focus:border-lavender focus:outline-none"
              />
            </label>
          ))
        }
        <button type="submit" class="btn btn-primary mt-2 w-full justify-center">
          {wp.credentials.cta} <span class="arw">→</span>
        </button>
      </form>
    </div>
  </section>

  <!-- CLOSING CTA (lavender band) -->
  <section class="bg-lavender py-20 text-ink md:py-28">
    <div class="wrap max-w-[60rem]">
      <h2 class="h-display max-w-[22ch] text-[clamp(2.25rem,6vw,4.5rem)]">
        {wp.closing.headline} {wp.closing.headlineAccent}
      </h2>
      <p class="mt-6 max-w-[46ch] text-lg leading-snug">{wp.closing.line}</p>
      <a class="btn btn-secondary mt-8" href={wp.closing.href}>
        {wp.closing.cta} <span class="arw">→</span>
      </a>
    </div>
  </section>

  <script is:inline>
    (() => {
      const chips = Array.from(document.querySelectorAll("[data-filter]"));
      const cards = Array.from(document.querySelectorAll(".work-card[data-cats]"));
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          chips.forEach((c) => c.classList.remove("is-active"));
          chip.classList.add("is-active");
          const f = chip.getAttribute("data-filter");
          cards.forEach((card) => {
            const list = (card.getAttribute("data-cats") || "").split(",");
            const show = f === "all" || list.includes(f);
            card.classList.toggle("is-hidden", !show);
          });
        });
      });
    })();
  </script>
</Layout>
