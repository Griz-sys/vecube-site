---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Vecube">
  <section class="py-12 md:py-16">
    <div class="wrap">
      <span class="label"><span class="dot"></span> About</span>
      <h1 class="h-display mt-4 text-[clamp(2.75rem,8vw,8rem)]">
        A small team<br />with <span class="text-blue">big output.</span>
      </h1>
      <p class="mt-8 max-w-[52ch] text-lg leading-snug text-grey-60">
        Vecube is a specialist paid-media studio helping global ecommerce brands think
        differently, grow faster and build lasting brand value — creative, media and data
        under one roof.
      </p>
      <a class="btn btn-primary mt-8" href="/contact">Work with us <span class="arw">→</span></a>
    </div>
  </section>
</Layout>
