---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/content";
---

<Layout title="Contact — Vecube">
  <section class="py-12 md:py-16">
    <div class="wrap grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <span class="label"><span class="dot"></span> Contact</span>
        <h1 class="h-display mt-4 text-[clamp(2.75rem,8vw,7rem)]">
          Let's<br /><span class="text-blue">talk.</span>
        </h1>
        <p class="mt-6 max-w-[36ch] text-grey-60">
          Want to grow fast? Tell us about your brand and we'll be in touch within one working day.
        </p>
        <a class="btn btn-secondary mt-6" href={`mailto:${site.email}`}>
          {site.email} <span class="arw">→</span>
        </a>
      </div>

      <div class="md:col-span-7">
        <!-- Wire this form to your backend / form service before launch. -->
        <form class="grid grid-cols-1 gap-5 sm:grid-cols-2" onsubmit="return false;">
          <input class="field" type="text" placeholder="First name*" required />
          <input class="field" type="text" placeholder="Last name*" required />
          <input class="field sm:col-span-2" type="text" placeholder="Company*" />
          <input class="field" type="email" placeholder="Email*" required />
          <input class="field" type="url" placeholder="Website" />
          <textarea class="field sm:col-span-2" rows="4" placeholder="Message*"></textarea>
          <button class="btn btn-primary sm:col-span-2 justify-self-start" type="submit">
            Submit <span class="arw">→</span>
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
